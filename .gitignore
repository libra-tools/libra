# Generated by Cargo
# will have compiled files and executables
debug
target
target-codex-review/
# .cargo/config.toml is TRACKED (repo-wide RUST_MIN_STACK for the test
# harness, W5-09): local-only cargo overrides belong in ~/.cargo/config.toml.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/
.vscode/
.qwen/
.trellis/
.cursor/
.agent/
.agents/
.air/

# Generated when moving Windows files to WSL
*:Zone.Identifier

.libra
.pnpm-store/

# Test credentials (never commit)
.env.test
.env

# Frontend
web/node_modules/
web/.next/
web/.pnpm-store/
# Static export embedded by build.rs; generated from web/ source when required.
web/out/

# Publish Worker (Phase 6/7)
worker/node_modules/
worker/.next/
worker/.open-next/
worker/.wrangler/
worker/.turbo/
worker/.pnpm-store/
worker/test-results/
worker/playwright-report/
worker/.next-types/
worker/.dev.vars
worker/.dev.vars.*
worker/cloudflare-env.d.ts
worker/*.tsbuildinfo
worker/coverage/

# Mac
.DS_Store
.gemini/
gha-creds-*.json

# AI
.codex
.claude
.antigravitycli
.omo
.opencode

# Integration
target*

# Stray local build artifacts (never commit compiled rlibs from ad-hoc builds)
*.rlib
